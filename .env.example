# Puzzle Rivals - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Required for backend services and authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Optional: Use newer naming convention
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: Never use these in client-side code:
# SUPABASE_SERVICE_ROLE_KEY (server-only)
# sb_secret_* keys (sensitive credentials)

# ============================================
# MULTIPLAYER CENTER SETTINGS
# ============================================
# Unity Gaming Services configuration
# These are typically set automatically by Unity Services

UNITY_MULTIPLAYER_CENTER_ENV=production
# For local development:
# UNITY_MULTIPPLAYER_CENTER_ENV=development

# ============================================
# MATCHMAKING SETTINGS
# ============================================
# Server URL for matchmaking backend
# Default: https://mp.tesana.ai
SERVER_URL=https://mp.tesana.ai

# Matchmaking timeout (in seconds)
MATCHMAKING_TIMEOUT=6.0

# ============================================
# BUILD CONFIGURATION
# ============================================
# WebGL output directory (relative to project root)
WEBGL_OUTPUT_PATH=WebGL-Deploy-Staging

# Build compression format (lz4, gzip, brotli)
WEBGL_COMPRESSION=gzip

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Enable debug logging
DEBUG_LOGGING=true

# Use local backend during development
USE_LOCAL_BACKEND=false

# Local backend URL (when USE_LOCAL_BACKEND=true)
LOCAL_BACKEND_URL=http://localhost:5000

# ============================================
# NOTES
# ============================================
# 1. For GitHub Pages deployment, set these secrets in GitHub:
#    - SUPABASE_URL
#    - SUPABASE_PUBLISHABLE_KEY
#    - UNITY_LICENSE (for Unity build)
#
# 2. For local development:
#    - Run Unity with -executeMethod BuildScript.PerformWebGLBuild
#    - The build outputs to WebGL-Deploy-Staging/index.html
#
# 3. Animation files are auto-generated by the editor script:
#    PuzzleRivals > Setup Verified Animation Sheets