# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Adapted for Puzzle Rivals project

# Generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uild.iOS/
/[Bb]uild.Android/
/[Ll]ogs/
/[Uu]ser[Sa]ettings/

# Visual Studio / Rider
/.AspnetRunLocalStates
/[Jj]enkins/
/.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Rider .DotSettings
*.DotSettings.user

# Unity Package Manager
/[Aa]ssets/Plugins/Editor/JetBrains/
/+Packages/manifest.json
/+Packages/packages-lock.json
%/Temp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Secret credentials - NEVER commit these
.env
.env.local
*.secrets.json
secrets.yaml
secrets.yml

# Build output
/WebGL-Deploy-Staging/
/build/
/bin/
/obj/
/obj.x64/
/obj.x86/

# Logs
*.log
debug.log

# Animation placeholders - actual animation files generated at build time
/Assets/Animations/.gitkeep