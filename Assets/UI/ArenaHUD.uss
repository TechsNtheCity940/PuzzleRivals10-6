.hud-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    padding-top: 24px;
}

.hud-panel {
    width: 72%;
    max-width: 920px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 32px;
    padding-right: 32px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Textures/UI/panel_hud.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.timer-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.timer-icon {
    width: 38px;
    height: 38px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Textures/UI/icon_timer.png");
    -unity-background-scale-mode: scale-to-fit;
}

.timer-bar {
    flex-grow: 1;
    max-width: 640px;
    height: 30px;
    background-color: rgba(5, 6, 12, 0.9);
    border-width: 2px;
    border-color: #00E6FF;
    border-radius: 10px;
}

.hud-label {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
}

.status-label {
    color: #FFD700;
    font-size: 48px;
    -unity-font-style: bold;
    margin-top: 100px;
    opacity: 0;
}

.clutch-label {
    color: #FF4500;
    font-size: 56px;
    -unity-font-style: bold;
    margin-top: -40px;
    opacity: 0;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}
